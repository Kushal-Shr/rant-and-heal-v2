# Firebase client configuration
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# Firebase Admin (server only)
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
FIREBASE_ADMIN_PRIVATE_KEY=

# Momo text responder (server only). Set gemini for the demo rollback path.
MOMO_TEXT_PROVIDER=openai
OPENAI_API_KEY=

# Gemini (server only). Planner, safety, voice, and rollback responder remain Gemini.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_SAFETY_MODEL=gemini-3.8-flash
# Optional; valid range is 4000-30000. Defaults to 10000.
MOMO_SAFETY_CLASSIFIER_TIMEOUT_MS=10000
GEMINI_LIVE_MODEL=gemini-3.8-live

# V4 trial feature flags
ENABLE_WEEKLY_REPORTS=true
ENABLE_AI_THERAPY_NOTES=true
ENABLE_SAFETY_DASHBOARD=true
# Keep false until voice has verified real-time safety interruption.
ENABLE_MOMO_VOICE=false
# Local development only. Logs structured routing metadata, never message text.
MOMO_DEBUG_ROUTING=false

# Therapy application-managed encryption (server only)
THERAPY_KMS_KEY_NAME=

# Optional TURN relay for therapist video calls (server only)
TURN_URLS=
TURN_USERNAME=
TURN_CREDENTIAL=

# Crisis-support display settings
NEXT_PUBLIC_CRISIS_CONTACT_NAME=
NEXT_PUBLIC_CRISIS_CONTACT_PHONE=

# Optional operational notification; disabled by default
SAFETY_SUPPORT_NOTIFICATIONS_ENABLED=false
RESEND_API_KEY=
SAFETY_ALERT_FROM_EMAIL=
SAFETY_SUPPORT_ALERT_EMAIL=

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function owner(uid) { return signedIn() && request.auth.uid == uid; }
    function safetyReviewer() {
      return signedIn() &&
        (request.auth.token.safetyReviewer == true || request.auth.token.admin == true);
    }
    function rel(id) {
      return get(/databases/$(database)/documents/therapy_relationships/$(id));
    }
    function activeParticipant(id) {
      return signedIn() && rel(id).data.status == 'ACTIVE' &&
        get(/databases/$(database)/documents/connections/$(rel(id).data.userId)).data.relationshipId == id &&
        get(/databases/$(database)/documents/connections/$(rel(id).data.userId)).data.status == 'ACTIVE' &&
        (request.auth.uid == rel(id).data.userId || request.auth.uid == rel(id).data.therapistId);
    }
    function currentTherapist(patientId) {
      return signedIn() &&
        get(/databases/$(database)/documents/connections/$(patientId)).data.therapistId == request.auth.uid &&
        get(/databases/$(database)/documents/connections/$(patientId)).data.status in ['PENDING', 'ACTIVE'];
    }
    function activeReportTherapist(patientId, relationshipId) {
      return signedIn() && relationshipId is string &&
        get(/databases/$(database)/documents/connections/$(patientId)).data.therapistId == request.auth.uid &&
        get(/databases/$(database)/documents/connections/$(patientId)).data.relationshipId == relationshipId &&
        get(/databases/$(database)/documents/connections/$(patientId)).data.status == 'ACTIVE';
    }

    match /users/{userId} {
      function validMomoPrivacyPreferences() {
        return !request.resource.data.keys().hasAny(['momoPrivacyPreferences']) ||
          (request.resource.data.momoPrivacyPreferences is map &&
           request.resource.data.momoPrivacyPreferences.keys().hasOnly([
             'moodTrendAnalyticsEnabled', 'outcomeAnalyticsEnabled'
           ]) &&
           request.resource.data.momoPrivacyPreferences.keys().hasAll([
             'moodTrendAnalyticsEnabled', 'outcomeAnalyticsEnabled'
           ]) &&
           request.resource.data.momoPrivacyPreferences.moodTrendAnalyticsEnabled is bool &&
           request.resource.data.momoPrivacyPreferences.outcomeAnalyticsEnabled is bool);
      }
      allow read: if owner(userId);
      allow create: if owner(userId) && request.resource.data.uid == userId &&
        request.resource.data.role == 'USER' && validMomoPrivacyPreferences();
      allow update: if owner(userId) &&
        request.resource.data.uid == resource.data.uid &&
        request.resource.data.role == resource.data.role && validMomoPrivacyPreferences();
      allow delete: if false;

      match /sessions/{sessionId} {
        function validEncryptedContent(content) {
          return content is map &&
            content.keys().hasOnly(['ciphertext', 'iv', 'algorithm', 'cryptoVersion']) &&
            content.keys().hasAll(['ciphertext', 'iv', 'algorithm', 'cryptoVersion']) &&
            content.ciphertext is string && content.ciphertext.size() > 0 && content.ciphertext.size() <= 50000 &&
            content.iv is string && content.iv.size() == 16 &&
            content.algorithm == 'AES-256-GCM' && content.cryptoVersion == 1;
        }
        allow read, delete: if owner(userId);
        allow create: if owner(userId) &&
          request.resource.data.keys().hasOnly(['title', 'createdAt']) &&
          request.resource.data.title is string && request.resource.data.title.size() <= 80 &&
          request.resource.data.createdAt == request.time;
        allow update: if owner(userId) &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'encryptedContinuity', 'cryptoVersion', 'updatedAt'
          ]) &&
          validEncryptedContent(request.resource.data.encryptedContinuity) &&
          request.resource.data.cryptoVersion == 1 && request.resource.data.updatedAt == request.time;
        match /messages/{messageId} {
          allow read: if owner(userId);
          function validEncryptedMessage() {
            return request.resource.data.keys().hasOnly([
                'userId', 'conversationId', 'role', 'modality', 'encryptedContent',
                'messageSequence', 'createdAt'
              ]) &&
              request.resource.data.keys().hasAll([
                'userId', 'conversationId', 'role', 'modality', 'encryptedContent',
                'messageSequence', 'createdAt'
              ]) &&
              request.resource.data.userId == userId &&
              request.resource.data.conversationId == sessionId &&
              request.resource.data.role in ['user', 'assistant'] &&
              request.resource.data.modality in ['text', 'voice'] &&
              validEncryptedContent(request.resource.data.encryptedContent) &&
              request.resource.data.messageSequence is int &&
              request.resource.data.createdAt == request.time;
          }
          allow create: if owner(userId) && validEncryptedMessage();
          allow update: if owner(userId) && validEncryptedMessage() &&
            request.resource.data.userId == resource.data.userId &&
            request.resource.data.conversationId == resource.data.conversationId &&
            request.resource.data.role == resource.data.role &&
            request.resource.data.modality == resource.data.modality;
          allow delete: if owner(userId);
        }
        match /requests/{requestId} { allow read, write: if false; }
      }
      match /usage/{usageId} { allow read, write: if false; }
      match /safety_events/{eventId} { allow read, write: if false; }
      match /momo_mood_analytics/{entryId} {
        allow read: if owner(userId);
        allow write: if false;
      }
      match /momo_outcome_analytics/{entryId} {
        allow read: if owner(userId);
        allow write: if false;
      }

      match /health_metrics/{entryId} {
        allow read: if owner(userId);
        function scoreIsValid(field) {
          return !request.resource.data.keys().hasAny([field]) ||
            (request.resource.data[field] is number && request.resource.data[field] >= 1 && request.resource.data[field] <= 10);
        }
        function validLegacyMood() {
          return request.resource.data.keys().hasOnly(['moodScore', 'anxietyScore', 'energyScore', 'note', 'createdAt']) &&
            request.resource.data.keys().hasAll(['moodScore', 'anxietyScore', 'energyScore', 'note', 'createdAt']) &&
            scoreIsValid('moodScore') && scoreIsValid('anxietyScore') && scoreIsValid('energyScore') &&
            request.resource.data.note is string && request.resource.data.note.size() <= 1000 &&
            request.resource.data.createdAt == request.time;
        }
        function validMoodContexts() {
          return !request.resource.data.keys().hasAny(['contexts']) ||
            (request.resource.data.contexts is list && request.resource.data.contexts.size() <= 12 &&
             request.resource.data.contexts.hasOnly([
               'work', 'academics', 'relationships', 'family', 'finances', 'health', 'sleep',
               'social-life', 'loneliness', 'future-uncertainty', 'self-esteem', 'workload',
               'major-event', 'good-conversation', 'exercise', 'achievement', 'rest', 'hobbies',
               'time-outside', 'friends', 'therapy', 'momo-conversation', 'relaxation', 'good-sleep', 'other'
             ]));
        }
        function validHelpfulFactors() {
          return !request.resource.data.keys().hasAny(['helpfulFactors']) ||
            (request.resource.data.helpfulFactors is list && request.resource.data.helpfulFactors.size() <= 10 &&
             request.resource.data.helpfulFactors.hasOnly([
               'talking-to-someone', 'rest', 'music', 'exercise', 'grounding', 'breathing',
               'journaling', 'going-outside', 'taking-a-break', 'planning-tasks', 'therapy',
               'momo', 'nothing-yet', 'other'
             ]));
        }
        function validV2Mood() {
          return request.resource.data.keys().hasOnly([
              'userId', 'moodScore', 'anxietyScore', 'energyScore', 'stressScore',
              'sleepQualityScore', 'focusScore', 'socialConnectionScore', 'physicalWellbeingScore',
              'contexts', 'helpfulFactors', 'note', 'timezone', 'localDate', 'schemaVersion', 'createdAt'
            ]) &&
            request.resource.data.keys().hasAll([
              'userId', 'moodScore', 'timezone', 'localDate', 'schemaVersion', 'createdAt'
            ]) &&
            request.resource.data.userId == userId && request.resource.data.schemaVersion == 2 &&
            scoreIsValid('moodScore') && scoreIsValid('anxietyScore') && scoreIsValid('energyScore') &&
            scoreIsValid('stressScore') && scoreIsValid('sleepQualityScore') && scoreIsValid('focusScore') &&
            scoreIsValid('socialConnectionScore') && scoreIsValid('physicalWellbeingScore') &&
            validMoodContexts() && validHelpfulFactors() &&
            (!request.resource.data.keys().hasAny(['note']) ||
              (request.resource.data.note is string && request.resource.data.note.size() <= 1000)) &&
            request.resource.data.timezone is string && request.resource.data.timezone.size() > 0 &&
            request.resource.data.timezone.size() <= 64 &&
            request.resource.data.localDate is string && request.resource.data.localDate.size() == 10 &&
            request.resource.data.createdAt == request.time;
        }
        allow create: if owner(userId) && (validLegacyMood() || validV2Mood());
        allow update, delete: if false;
      }

      match /journals/{entryId} {
        function validEncryptedJournal() {
          return request.resource.data.keys().hasOnly([
              'userId', 'ciphertext', 'iv', 'cryptoVersion', 'createdAt', 'updatedAt'
            ]) &&
            request.resource.data.keys().hasAll([
              'userId', 'ciphertext', 'iv', 'cryptoVersion', 'createdAt', 'updatedAt'
            ]) &&
            request.resource.data.userId == userId &&
            request.resource.data.ciphertext is string &&
            request.resource.data.ciphertext.size() > 0 && request.resource.data.ciphertext.size() <= 50000 &&
            request.resource.data.iv is string && request.resource.data.iv.size() == 16 &&
            request.resource.data.cryptoVersion == 1 &&
            request.resource.data.createdAt is timestamp && request.resource.data.updatedAt is timestamp;
        }
        allow read: if owner(userId);
        allow create: if owner(userId) && validEncryptedJournal() &&
          request.resource.data.createdAt == request.time && request.resource.data.updatedAt == request.time;
        allow update: if owner(userId) && validEncryptedJournal() &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'userId', 'ciphertext', 'iv', 'cryptoVersion', 'title', 'body', 'moodTag', 'updatedAt'
          ]) &&
          request.resource.data.createdAt == resource.data.createdAt &&
          request.resource.data.updatedAt == request.time;
        allow delete: if owner(userId);
      }

      match /vault/{metadataId} {
        allow read: if owner(userId) && metadataId == 'config';
        allow create: if owner(userId) && metadataId == 'config' &&
          request.resource.data.keys().hasOnly(['version', 'kdf', 'verification', 'createdAt']) &&
          request.resource.data.version == 1 &&
          request.resource.data.kdf is map &&
          request.resource.data.kdf.keys().hasOnly(['algorithm', 'hash', 'iterations', 'salt']) &&
          request.resource.data.kdf.algorithm == 'PBKDF2' &&
          request.resource.data.kdf.hash == 'SHA-256' &&
          request.resource.data.kdf.iterations is int &&
          request.resource.data.kdf.iterations >= 210000 && request.resource.data.kdf.iterations <= 2000000 &&
          request.resource.data.kdf.salt is string && request.resource.data.kdf.salt.size() >= 24 &&
          request.resource.data.verification is map &&
          request.resource.data.verification.keys().hasOnly(['ciphertext', 'iv']) &&
          request.resource.data.verification.ciphertext is string &&
          request.resource.data.verification.iv is string && request.resource.data.verification.iv.size() == 16 &&
          request.resource.data.createdAt == request.time;
        allow update, delete: if false;
      }

      match /journal_metrics/{entryId} {
        function validUserReported() {
          return !request.resource.data.keys().hasAny(['userReported']) ||
            (request.resource.data.userReported is map &&
             request.resource.data.userReported.keys().hasOnly(['emotions', 'contexts', 'intent']) &&
             (!request.resource.data.userReported.keys().hasAny(['emotions']) ||
               (request.resource.data.userReported.emotions is list && request.resource.data.userReported.emotions.size() <= 8 &&
                request.resource.data.userReported.emotions.hasOnly(['ANXIOUS', 'SAD', 'ANGRY', 'LONELY', 'CALM', 'HAPPY', 'OVERWHELMED', 'OTHER']))) &&
             (!request.resource.data.userReported.keys().hasAny(['contexts']) ||
               (request.resource.data.userReported.contexts is list && request.resource.data.userReported.contexts.size() <= 9 &&
                request.resource.data.userReported.contexts.hasOnly(['ACADEMIC', 'FAMILY', 'RELATIONSHIP', 'WORK', 'HEALTH', 'FINANCIAL', 'PERSONAL', 'SOCIAL', 'OTHER']))) &&
             (!request.resource.data.userReported.keys().hasAny(['intent']) ||
               request.resource.data.userReported.intent in ['VENT', 'UNDERSTAND', 'MAKE_DECISION', 'CALM_DOWN', 'REFLECT', 'OTHER']));
        }
        function validJournalMetric() {
          return request.resource.data.keys().hasOnly([
              'userId', 'journalEntryId', 'createdAt', 'updatedAt', 'behavior', 'userReported', 'schemaVersion'
            ]) &&
            request.resource.data.keys().hasAll([
              'userId', 'journalEntryId', 'createdAt', 'updatedAt', 'behavior', 'schemaVersion'
            ]) &&
            request.resource.data.userId == userId &&
            request.resource.data.journalEntryId == entryId &&
            request.resource.data.schemaVersion == 1 &&
            request.resource.data.createdAt is timestamp && request.resource.data.updatedAt is timestamp &&
            request.resource.data.behavior is map &&
            request.resource.data.behavior.keys().hasOnly(['lengthBucket', 'timeOfDay', 'localDate', 'wasEdited']) &&
            request.resource.data.behavior.lengthBucket in ['SHORT', 'MEDIUM', 'LONG'] &&
            request.resource.data.behavior.timeOfDay in ['MORNING', 'AFTERNOON', 'EVENING', 'LATE_NIGHT'] &&
            request.resource.data.behavior.localDate is string && request.resource.data.behavior.localDate.size() == 10 &&
            request.resource.data.behavior.wasEdited is bool && validUserReported();
        }
        allow read: if owner(userId);
        allow create: if owner(userId) && validJournalMetric() &&
          request.resource.data.createdAt == getAfter(/databases/$(database)/documents/users/$(userId)/journals/$(entryId)).data.createdAt &&
          request.resource.data.updatedAt == request.time;
        allow update: if owner(userId) && validJournalMetric() &&
          request.resource.data.userId == resource.data.userId &&
          request.resource.data.journalEntryId == resource.data.journalEntryId &&
          request.resource.data.createdAt == resource.data.createdAt &&
          request.resource.data.updatedAt == request.time;
        allow delete: if owner(userId);
      }
    }

    match /patient_profiles/{patientId} {
      allow read: if owner(patientId) || currentTherapist(patientId);
      allow write: if false;
    }

    // Safety cases are readable only by explicit custom claim. All writes,
    // including append-only actions, go through the authenticated Admin SDK
    // transaction service so clients cannot forge or rewrite audit history.
    match /safety_cases/{caseId} {
      allow read: if safetyReviewer();
      allow write: if false;
      match /actions/{actionId} {
        allow read: if safetyReviewer();
        allow write: if false;
      }
    }

    match /safety_case_episodes/{episodeId} {
      allow read, write: if false;
    }

    match /momo_conversation_keys/{keyId} {
      allow read, write: if false;
    }

    match /therapists/{therapistId} {
      allow read: if signedIn() && (resource.data.isVerified == true || request.auth.uid == therapistId);
      allow create: if owner(therapistId) &&
        request.resource.data.keys().hasOnly([
          'therapistId', 'name', 'specialty', 'licenseNo', 'bio', 'availability',
          'isVerified', 'verificationStatus', 'createdAt'
        ]) &&
        request.resource.data.therapistId == therapistId &&
        request.resource.data.isVerified == false &&
        request.resource.data.verificationStatus == 'PENDING' &&
        request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 100 &&
        request.resource.data.specialty is string && request.resource.data.specialty.size() > 0 && request.resource.data.specialty.size() <= 300 &&
        request.resource.data.licenseNo is string && request.resource.data.licenseNo.size() > 0 && request.resource.data.licenseNo.size() <= 100 &&
        request.resource.data.bio is string && request.resource.data.bio.size() <= 3000 &&
        request.resource.data.availability is map &&
        request.resource.data.createdAt == request.time;
      allow update: if owner(therapistId) &&
        resource.data.verificationStatus in ['PENDING', 'REJECTED'] &&
        request.resource.data.therapistId == resource.data.therapistId &&
        request.resource.data.isVerified == resource.data.isVerified &&
        (request.resource.data.verificationStatus == resource.data.verificationStatus ||
          (resource.data.verificationStatus == 'REJECTED' && request.resource.data.verificationStatus == 'PENDING')) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'name', 'specialty', 'licenseNo', 'bio', 'availability', 'verificationStatus'
        ]) &&
        request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 100 &&
        request.resource.data.specialty is string && request.resource.data.specialty.size() > 0 && request.resource.data.specialty.size() <= 300 &&
        request.resource.data.licenseNo is string && request.resource.data.licenseNo.size() > 0 && request.resource.data.licenseNo.size() <= 100 &&
        request.resource.data.bio is string && request.resource.data.bio.size() <= 3000;
    }

    match /connections/{patientId} {
      allow read: if owner(patientId) ||
        (signedIn() && request.auth.uid == resource.data.therapistId && resource.data.status in ['PENDING', 'ACTIVE']);
      allow write: if false;
    }

    match /weekly_reports/{reportId} {
      allow read: if signedIn() &&
        (request.auth.uid == resource.data.userId ||
          (resource.data.sharedWithTherapist == true && activeReportTherapist(resource.data.userId, resource.data.relationshipId)));
      allow write: if false;
    }

    match /therapy_keys/{relationshipId} { allow read, write: if false; }

    match /therapy_relationships/{relationshipId} {
      allow read: if signedIn() &&
        (request.auth.uid == resource.data.userId ||
          (request.auth.uid == resource.data.therapistId && resource.data.status in ['PENDING', 'ACTIVE']));
      allow create, delete: if false;
      allow update: if activeParticipant(relationshipId) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastMessageAt', 'updatedAt']) &&
        request.resource.data.lastMessageAt == request.time && request.resource.data.updatedAt == request.time;

      match /events/{eventId} {
        allow read: if signedIn() &&
          (request.auth.uid == rel(relationshipId).data.userId ||
            (request.auth.uid == rel(relationshipId).data.therapistId && rel(relationshipId).data.status in ['PENDING', 'ACTIVE']));
        allow write: if false;
      }

      match /messages/{messageId} {
        allow read, write: if false;
      }

      match /session_notes/{noteId} { allow read, write: if false; }
      match /weekly_therapy_summaries/{summaryId} { allow read, write: if false; }
      match /weekly_reflections/{reflectionId} { allow read, write: if false; }

      match /call_sessions/{sessionId} {
        function session() {
          return get(/databases/$(database)/documents/therapy_relationships/$(relationshipId)/call_sessions/$(sessionId));
        }
        allow read: if activeParticipant(relationshipId) &&
          (request.auth.uid == resource.data.patientId || request.auth.uid == resource.data.therapistId);
        allow create, update, delete: if false;
        match /transcripts/{transcriptId} { allow read, write: if false; }
        match /signals/{signalId} {
          allow read: if activeParticipant(relationshipId) &&
            (request.auth.uid == session().data.patientId || request.auth.uid == session().data.therapistId);
          allow create: if activeParticipant(relationshipId) &&
            request.resource.data.keys().hasOnly(['senderId', 'type', 'payload', 'createdAt']) &&
            request.resource.data.senderId == request.auth.uid &&
            request.resource.data.type in ['offer', 'answer', 'ice-candidate', 'hangup'] &&
            request.resource.data.payload is map &&
            request.resource.data.createdAt == request.time &&
            session().data.status in ['RINGING', 'ACTIVE'] && session().data.expiresAt > request.time &&
            (request.auth.uid == session().data.patientId || request.auth.uid == session().data.therapistId);
          allow update, delete: if false;
        }
      }
      match /call_state/{stateId} { allow read, write: if false; }
    }
  }
}

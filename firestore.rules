rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isTherapist() {
      return isSignedIn() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'THERAPIST';
    }

    function isVerifiedTherapist() {
      return isTherapist() &&
        get(/databases/$(database)/documents/therapists/$(request.auth.uid)).data.isVerified == true;
    }

    function isVerifiedTherapistProfile(therapistId) {
      return get(/databases/$(database)/documents/users/$(therapistId)).data.role == 'THERAPIST' &&
        get(/databases/$(database)/documents/therapists/$(therapistId)).data.isVerified == true;
    }

    function activeConnection(userId) {
      return get(/databases/$(database)/documents/connections/$(userId)).data.status == 'ACTIVE';
    }
    
    // Identity Tier
    match /users/{userId} {
      allow read: if isOwner(userId) ||
        (isSignedIn() &&
          get(/databases/$(database)/documents/connections/$(userId)).data.status == 'ACTIVE' &&
          get(/databases/$(database)/documents/connections/$(userId)).data.therapistId == request.auth.uid);
      // A public client may only create a patient identity. Practitioner and
      // administrator roles are assigned by a privileged server workflow.
      allow create: if isOwner(userId) &&
        request.resource.data.uid == userId &&
        request.resource.data.role == 'USER';
      allow update: if isOwner(userId) && 
                       request.resource.data.uid == resource.data.uid &&
                       request.resource.data.role == resource.data.role;
      allow delete: if isOwner(userId);

      match /sessions/{sessionId} {
        allow read, create, delete: if isOwner(userId);
        allow update: if isOwner(userId);

        match /messages/{messageId} {
          allow read: if isOwner(userId);
          allow write: if false;
        }
      }

      match /health_metrics/{entryId} {
        allow read, write: if isOwner(userId);
      }

      // Safety events are written by authenticated server handlers only.
      // They are intentionally not exposed to the browser while the clinical
      // review and follow-up workflow is still being designed.
      match /safety_events/{eventId} {
        allow read, write: if false;
      }

      match /journals/{entryId} {
        allow read, write: if isOwner(userId);
      }
    }
    
    match /therapists/{therapistId} {
      allow read: if isSignedIn() &&
        (resource.data.isVerified == true || request.auth.uid == therapistId);
      // Public applicants can submit editable profiles, but cannot verify
      // themselves or promote their account. Firebase Admin bypasses rules.
      allow create: if isSignedIn() && request.auth.uid == therapistId &&
        request.resource.data.therapistId == therapistId &&
        request.resource.data.isVerified == false &&
        request.resource.data.verificationStatus == 'PENDING' &&
        request.resource.data.name is string &&
        request.resource.data.specialty is string &&
        request.resource.data.licenseNo is string &&
        request.resource.data.bio is string &&
        request.resource.data.availability is map;
      allow update: if isSignedIn() && request.auth.uid == therapistId &&
        resource.data.verificationStatus in ['PENDING', 'REJECTED'] &&
        request.resource.data.therapistId == resource.data.therapistId &&
        request.resource.data.isVerified == resource.data.isVerified &&
        (request.resource.data.verificationStatus == resource.data.verificationStatus ||
          (resource.data.verificationStatus == 'REJECTED' &&
            request.resource.data.verificationStatus == 'PENDING')) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'name', 'specialty', 'licenseNo', 'bio', 'availability', 'verificationStatus'
        ]);
    }

    // Relationship Tier
    match /connections/{userId} {
      allow create: if isOwner(userId) &&
        request.resource.data.userId == userId &&
        request.resource.data.therapistId is string &&
        isVerifiedTherapistProfile(request.resource.data.therapistId) &&
        request.resource.data.status == 'PENDING';
      allow read: if isOwner(userId) ||
        (isSignedIn() && request.auth.uid == resource.data.therapistId);
      allow update: if (
        isOwner(userId) &&
        request.resource.data.userId == resource.data.userId &&
        (
          (
            request.resource.data.therapistId == resource.data.therapistId &&
            request.resource.data.status == 'REVOKED'
          ) || (
            resource.data.status in ['REJECTED', 'REVOKED'] &&
            request.resource.data.therapistId is string &&
            request.resource.data.status == 'PENDING'
          )
        )
      ) || (
        isVerifiedTherapist() &&
        request.auth.uid == resource.data.therapistId &&
        request.resource.data.userId == resource.data.userId &&
        request.resource.data.therapistId == resource.data.therapistId &&
        request.resource.data.status in ['ACTIVE', 'REJECTED']
      ) || (
        isSignedIn() &&
        activeConnection(userId) &&
        (request.auth.uid == userId || request.auth.uid == resource.data.therapistId) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastMessageAt', 'updatedAt'])
      );
      allow delete: if false;

      match /messages/{messageId} {
        allow read: if isSignedIn() && activeConnection(userId) &&
          (request.auth.uid == userId ||
            request.auth.uid == get(/databases/$(database)/documents/connections/$(userId)).data.therapistId);
        allow create: if isSignedIn() && activeConnection(userId) &&
          request.resource.data.senderId == request.auth.uid &&
          request.resource.data.text is string &&
          ((request.auth.uid == userId && request.resource.data.senderRole == 'USER') ||
            (request.auth.uid == get(/databases/$(database)/documents/connections/$(userId)).data.therapistId &&
              request.resource.data.senderRole == 'THERAPIST'));
        allow update, delete: if false;
      }

      match /call_sessions/{sessionId} {
        function isParticipant() {
          return isSignedIn() && activeConnection(userId) &&
            (request.auth.uid == resource.data.patientId ||
              request.auth.uid == resource.data.therapistId);
        }

        allow read: if isParticipant();
        // Sessions are created through the authenticated route handler so it
        // can atomically prevent more than one ringing or active call.
        allow create: if false;
        // State transitions are server-owned so the call lock and session
        // state remain atomic.
        allow update: if false;
        allow delete: if false;

        match /signals/{signalId} {
          function callSession() {
            return get(/databases/$(database)/documents/connections/$(userId)/call_sessions/$(sessionId));
          }

          allow read: if isSignedIn() && activeConnection(userId) &&
            (request.auth.uid == get(/databases/$(database)/documents/connections/$(userId)).data.userId ||
              request.auth.uid == get(/databases/$(database)/documents/connections/$(userId)).data.therapistId);
          allow create: if isSignedIn() && activeConnection(userId) &&
            request.resource.data.senderId == request.auth.uid &&
            request.resource.data.type in ['offer', 'answer', 'ice-candidate', 'hangup'] &&
            request.resource.data.payload is map &&
            callSession().data.status in ['RINGING', 'ACTIVE'] &&
            (request.auth.uid == callSession().data.patientId ||
              request.auth.uid == callSession().data.therapistId);
          allow update, delete: if false;
        }
      }
    }
  }
}

{
  "name": "rant-and-heal-v2",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "node --no-warnings --experimental-strip-types --test tests/*.test.mjs",
    "test:rules": "FIREBASE_CLI_DISABLE_TELEMETRY=true XDG_CONFIG_HOME=/tmp/rant-and-heal-firebase firebase emulators:exec --only firestore --project demo-rant-and-heal \"node --test tests/firestore-rules.emulator.mjs\"",
    "test:all": "npm test && npm run test:rules",
    "check": "npm run lint && npm run typecheck && npm test",
    "migrate:therapy": "node scripts/migrate-therapy-relationships.mjs",
    "set-admin": "node scripts/set-admin-claim.mjs"
  },
  "dependencies": {
    "@google/genai": "^1.33.0",
    "firebase": "^12.19.0",
    "firebase-admin": "^13.10.0",
    "js-cookie": "^3.0.5",
    "next": "16.2.4",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "resend": "^6.28.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "@tailwindcss/postcss": "^4",
    "@types/js-cookie": "^3.0.6",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.4",
    "firebase-tools": "^15.30.2",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
